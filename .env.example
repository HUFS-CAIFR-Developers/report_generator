OPENAI_API_KEY=
OPENDART_API_KEY=

# 선택 기능 - 없으면 그냥 건너뜀
TELEGRAM_BOT_TOKEN=
TELEGRAM_DOCX_CHAT_ID=
TELEGRAM_CHAT_ID=
REPORT_API_URL=https://api.caifr.com/api/generator/reports
REPORT_API_TOKEN=

# --- 쇼츠 영상 자동 생성 (리포트 다음 단계, docs/SHORTS.md) ---
# 끄려면 false. 켜져 있으면 아래 키가 모두 필요하다 (OPENAI_API_KEY는 위 값을 같이 쓴다)
SHORTS_ENABLED=true
TYPECAST_API_KEY=
# Higgsfield 인증 헤더는 "Key <API_KEY>:<API_SECRET>" 형식으로 조립된다
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_SECRET=
# YouTube OAuth2 (발급 방법은 docs/SHORTS.md). YOUTUBE_UPLOAD=false면 필요 없음
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
# 비워두면 n8n 때처럼 공개 범위 없이 올린다 (구독자 알림 켜짐). 처음 며칠은 private으로 확인 권장
# YOUTUBE_PRIVACY_STATUS=private
# YOUTUBE_UPLOAD=true
# SHORTS_TIMEOUT_SECONDS=5400
# SHORTS_OUTPUT_DIR=output/shorts
# 세부 설정 (기본값 = 기존 n8n 워크플로우 설정)
# OPENAI_MODEL=gpt-5.6-sol
# TYPECAST_VOICE_ID=tc_68257f68bc6e3c161ab5078d
# TYPECAST_MODEL=ssfm-v30
# POLL_INTERVAL_SEC=5
# POLL_TIMEOUT_SEC=1800
# SPEED_FACTOR=1.5
# KEEP_TEMP=false
